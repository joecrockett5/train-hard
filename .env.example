# Copy to .env and edit if you want to change anything. Every value below is
# the default that docker-compose.yml already falls back to, so the stack runs
# with no .env file at all.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Ports on the host. Change these if something already owns them.
# ---------------------------------------------------------------------------

# SvelteKit production server. http://localhost:3000
FRONTEND_HOST_PORT=3000

# Which interface the frontend is published on. 0.0.0.0 so a phone on the same
# network can reach it; set to 127.0.0.1 to keep it on this machine only.
# The backend and DynamoDB are always loopback-only -- a profile id is the
# only credential the API needs, so it should not be reachable from the LAN.
FRONTEND_BIND=0.0.0.0

# SvelteKit dev server, dev override only. http://localhost:5173
FRONTEND_DEV_HOST_PORT=5173

# FastAPI. http://localhost:8000 -- docs at /docs, health at /health
BACKEND_HOST_PORT=8000

# DynamoDB Local. 8001 on the host because the backend already has 8000;
# inside the compose network it is always http://dynamodb:8000
DYNAMODB_HOST_PORT=8001

# ---------------------------------------------------------------------------
# DynamoDB
# ---------------------------------------------------------------------------

# Must match the table scripts/init_tables.py creates.
DYNAMO_TABLE_NAME=hardResources

# GSI used to look items up by object_id.
DYNAMO_ITEM_INDEX_NAME=ItemSearch

# ---------------------------------------------------------------------------
# AWS credentials -- dummy values
#
# DynamoDB Local ignores credentials entirely, but boto3 refuses to sign a
# request without a region and an access key pair, so these have to be
# present. They are not secrets and grant nothing.
#
# To point the backend at real AWS instead: unset DYNAMODB_ENDPOINT_URL in
# docker-compose.yml and put real credentials here.
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---------------------------------------------------------------------------
# Service wiring
# ---------------------------------------------------------------------------

# How the frontend works out the URL the browser is using. SvelteKit's
# adapter-node compares that against the Origin header on form POSTs
# (selecting a profile, creating one) and rejects them with 403 if the two
# disagree. It also decides whether the profile cookie is marked Secure.
#
# Set to the exact URL in the address bar -- scheme, host and port, e.g.
# https://training.jmedia or http://localhost:3000. Getting it wrong makes
# selecting a profile silently do nothing (a 403 the UI does not surface).
#
# BEHIND A REVERSE PROXY, blank it instead:
#
#   ORIGIN=
#
# and the origin is read per request from the proxy headers below. That is
# the only way to serve http:// and https:// at the same time -- a fixed
# ORIGIN can only ever match one of them, so devices on the other scheme get
# 403s on every form POST. It also means the profile cookie is marked Secure
# only on the requests that really are secure.
#
# Blank it only when something in front actually sets those headers.
# Unproxied, the adapter assumes https when the header is missing, and a
# plain http:// visitor is then refused.
ORIGIN=http://localhost:3000

# The headers the proxy sets, used when ORIGIN is empty. The defaults are
# what Nginx Proxy Manager, Caddy and Traefik send. Only meaningful behind a
# proxy: exposed directly, a client could claim whatever origin it liked.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host

# Where the SvelteKit server finds the backend, over the compose network.
# Note the /api suffix: the FastAPI routers are mounted under /api.
#
# This is read server-side only. The browser never calls the backend
# directly -- it calls the SvelteKit app's own /api/* routes, which proxy on.
# That is why no browser-facing backend URL is needed, and why there is no
# CORS configuration anywhere in the backend.
HARD_API=http://backend:8000/api
