# Copy to .env and edit if you want to change anything. Every value below is
# the default that docker-compose.yml already falls back to, so the stack runs
# with no .env file at all.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Ports on the host. Change these if something already owns them.
# ---------------------------------------------------------------------------

# SvelteKit production server. http://localhost:3000
FRONTEND_HOST_PORT=3000

# SvelteKit dev server, dev override only. http://localhost:5173
FRONTEND_DEV_HOST_PORT=5173

# FastAPI. http://localhost:8000 -- docs at /docs, health at /health
BACKEND_HOST_PORT=8000

# DynamoDB Local. 8001 on the host because the backend already has 8000;
# inside the compose network it is always http://dynamodb:8000
DYNAMODB_HOST_PORT=8001

# ---------------------------------------------------------------------------
# DynamoDB
# ---------------------------------------------------------------------------

# Must match the table scripts/init_tables.py creates.
DYNAMO_TABLE_NAME=hardResources

# GSI used to look items up by object_id.
DYNAMO_ITEM_INDEX_NAME=ItemSearch

# ---------------------------------------------------------------------------
# AWS credentials -- dummy values
#
# DynamoDB Local ignores credentials entirely, but boto3 refuses to sign a
# request without a region and an access key pair, so these have to be
# present. They are not secrets and grant nothing.
#
# To point the backend at real AWS instead: unset DYNAMODB_ENDPOINT_URL in
# docker-compose.yml and put real credentials here.
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---------------------------------------------------------------------------
# Service wiring
# ---------------------------------------------------------------------------

# The browser-facing URL of the frontend. SvelteKit's adapter-node compares
# this against the Origin header on form POSTs (selecting a profile, creating
# one) and rejects them with 403 if it does not match. Keep it in step with
# FRONTEND_HOST_PORT, and change it if you reach the app at something other
# than localhost.
ORIGIN=http://localhost:3000

# Where the SvelteKit server finds the backend, over the compose network.
# Note the /api suffix: the FastAPI routers are mounted under /api.
#
# This is read server-side only. The browser never calls the backend
# directly -- it calls the SvelteKit app's own /api/* routes, which proxy on.
# That is why no browser-facing backend URL is needed, and why there is no
# CORS configuration anywhere in the backend.
HARD_API=http://backend:8000/api
